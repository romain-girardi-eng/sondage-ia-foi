    "dateCreated": "2025-01-01",
    "dateModified": "2026-09-07",
    "description": {
      "fr": "Système de scoring de l'étude « IA & Foi chrétienne ». Outil exploratoire : les profils sont une attribution heuristique, pas un diagnostic.",
      "en": "Scoring system for the \"AI & Christian faith\" study. Exploratory tool: profiles are a heuristic attribution, not a diagnosis."
    },
    "keywords": [
      "artificial intelligence",
      "religion",
      "Christianity",
      "CRS-5",
      "social desirability",
      "spirituality"
    ],
    "instruments": [
      {
        "name": "CRS-5 (Huber & Huber, 2012)",
        "status": "adapted",
        "note": "Wording localised and private-practice frequencies recoded; not administered verbatim"
      },
      {
        "name": "Marlowe-Crowne items (Crowne & Marlowe, 1960)",
        "status": "exploratory",
        "note": "Ad hoc selection of 5 items, not a validated short form"
      },
      {
        "name": "Godspeed series (Bartneck et al., 2009)",
        "status": "inspired_by",
        "note": "Two items inspired by the anthropomorphism dimension"
      },
      {
        "name": "AIAS (Wang & Wang, 2022)",
        "status": "inspired_by",
        "note": "One opacity item inspired by the AI anxiety scale"
      }
    ],
    "exploratoryConstructs": [
      "AI openness",
      "Sacred boundary",
      "Ethical concern",
      "Community context",
      "Future orientation"
    ],
    "limitationsAcknowledged": [
      "Profile attribution is heuristic: ideal ranges and weights are expert-set, not derived from cluster analysis",
      "Five of seven dimensions are ad hoc constructs without factor analysis",
      "The 5 social-desirability items are not a validated short form",
      "No client-side percentile: comparisons require the empirical norms endpoint and N >= 30",
      "Self-selected sample, not representative of any Christian population",
      "Cross-cultural validity not established (French and English only)"
    ],
    "recommendedCitations": [
      "Huber, S., & Huber, O. W. (2012). The Centrality of Religiosity Scale (CRS). Religions, 3(3), 710-724. https://doi.org/10.3390/rel3030710",
      "Crowne, D. P., & Marlowe, D. (1960). A new scale of social desirability independent of psychopathology. Journal of Consulting Psychology, 24(4), 349-354.",
      "Reynolds, W. M. (1982). Development of reliable and valid short forms of the Marlowe-Crowne Social Desirability Scale. Journal of Clinical Psychology, 38(1), 119-125. (cited for context on short forms; none of them is used here)",
      "Bartneck, C., Kulić, D., Croft, E., & Zoghbi, S. (2009). Measurement instruments for the anthropomorphism, animacy, likeability, perceived intelligence, and perceived safety of robots. International Journal of Social Robotics, 1(1), 71-81.",
      "Wang, Y. Y., & Wang, Y. S. (2022). Development and validation of an artificial intelligence anxiety scale. Interactive Learning Environments, 30(4), 619-634."
    ]
  },
  "dimensions": {
    "religiosity": {
      "id": "religiosity",
      "name": {
        "fr": "Centralité de la religiosité (CRS-5, adapté)",
        "en": "Centrality of religiosity (CRS-5, adapted)"
      },
      "description": {
        "fr": "Moyenne brute des 5 items CRS-5, sans correction de désirabilité sociale",
        "en": "Raw mean of the 5 CRS-5 items, with no social-desirability correction"
      },
      "validationStatus": "adapted",
      "sourceInstrument": "CRS-5 (Huber & Huber, 2012), adapted wording",
      "scale": {
        "min": 1,
        "max": 5
      },
      "minItems": 4,
      "aggregation": "Weighted mean over answered items; value = null below minItems; confidence = nItems / maxItems",
      "missingPolicy": "\"ne sait pas\", \"sans réponse\", unanswered and unrecognised values are excluded from the mean and never imputed",
      "questions": [
        {
          "questionId": "crs_intellect",
          "weight": 1,
          "scoringLogic": "jamais=1, rarement=2, occasionnellement=3, souvent=4, tres_souvent=5",
          "core": true
        },
        {
          "questionId": "crs_ideology",
          "weight": 1,
          "scoringLogic": "pas_du_tout=1, peu=2, moderement=3, beaucoup=4, totalement=5",
          "core": true
        },
        {
          "questionId": "crs_public_practice",
          "weight": 1,
          "scoringLogic": "jamais=1, rarement=2, quelques_fois_an=3, mensuel=4, hebdomadaire(+)=5 (v1 hebdo/pluri_hebdo=5)",
          "core": true
        },
        {
          "questionId": "crs_private_practice",
          "weight": 1,
          "scoringLogic": "jamais=1, rarement=2, mensuel=3, hebdomadaire=4, quotidien=5, pluri_quotidien=5 (Huber recoding)",
          "core": true
        },
        {
          "questionId": "crs_experience",
          "weight": 1,
          "scoringLogic": "jamais=1, rarement=2, occasionnellement=3, souvent=4, tres_souvent=5",
          "core": true
        }
      ]
    },
    "aiOpenness": {
      "id": "aiOpenness",
      "name": {
        "fr": "Ouverture à l'IA",
        "en": "AI openness"
      },
      "description": {
        "fr": "Fréquence d'usage déclarée, maîtrise perçue et attitude générale envers le numérique",
        "en": "Declared usage frequency, perceived proficiency and general attitude toward digital tools"
      },
      "validationStatus": "exploratory",
      "sourceInstrument": null,
      "scale": {
        "min": 1,
        "max": 5
      },
      "minItems": 2,
      "aggregation": "Weighted mean over answered items; value = null below minItems; confidence = nItems / maxItems",
      "missingPolicy": "\"ne sait pas\", \"sans réponse\", unanswered and unrecognised values are excluded from the mean and never imputed",
      "questions": [
        {
          "questionId": "ctrl_ia_frequence",
          "weight": 1,
          "scoringLogic": "jamais=1, essaye=2, occasionnel=3, regulier=4, quotidien=5",
          "core": true
        },
        {
          "questionId": "ctrl_ia_confort",
          "weight": 1,
          "scoringLogic": "direct 1-5 slider",
          "core": true
        },
        {
          "questionId": "digital_attitude_generale",
          "weight": 1,
          "scoringLogic": "tres_negatif=1 ... tres_positif=5",
          "core": true
        },
        {
          "questionId": "ctrl_ia_contextes",
          "weight": 1,
          "scoringLogic": "count: 1 + 0.8 * number of contexts, capped at 5",
          "conditionalOn": "ctrl_ia_frequence !== jamais",
          "core": false
        },
        {
          "questionId": "min_pred_usage",
          "weight": 1,
          "scoringLogic": "jamais=1, rare=2, regulier=4, systematique=5",
          "conditionalOn": "isClergy",
          "core": false
        },
        {
          "questionId": "min_pred_nature",
          "weight": 1,
          "scoringLogic": "matrix: weighted delegation level (plan 1, exegese 2, illustration 1, images 1, redaction 3) rescaled to 1-5",
          "conditionalOn": "clergyUsesAI",
          "core": false
        },
        {
          "questionId": "min_admin_burden",
          "weight": 0.5,
          "scoringLogic": "direct 1-5 slider",
          "conditionalOn": "clergyUsesAI",
          "core": false
        }
      ]
    },
    "sacredBoundary": {
      "id": "sacredBoundary",
      "name": {
        "fr": "Frontière sacrée",
        "en": "Sacred boundary"
      },
      "description": {
        "fr": "Étendue des actes spirituels que le répondant exclut d'une médiation par l'IA",
        "en": "Extent of spiritual acts the respondent excludes from AI mediation"
      },
      "validationStatus": "exploratory",
      "sourceInstrument": null,
      "scale": {
        "min": 1,
        "max": 5
      },
      "minItems": 2,
      "aggregation": "Weighted mean over answered items; value = null below minItems; confidence = nItems / maxItems",
      "missingPolicy": "\"ne sait pas\", \"sans réponse\", unanswered and unrecognised values are excluded from the mean and never imputed",
      "questions": [
        {
          "questionId": "theo_inspiration",
          "weight": 1,
          "scoringLogic": "possible=1, possible_indirect=2, peu_probable=4, impossible=5",
          "core": true
        },
        {
          "questionId": "theo_liturgie_ia",
          "weight": 1,
          "scoringLogic": "reversed slider (6 - value): acceptability inverts into boundary",
          "core": true
        },
        {
          "questionId": "theo_activites_sacrees",
          "weight": 1,
          "scoringLogic": "aucune=1, else 1 + 0.9 * number of protected activities, capped at 5",
          "core": true
        },
        {
          "questionId": "theo_mediation_humaine",
          "weight": 1,
          "scoringLogic": "non_pas_necessairement=1, partiellement=2, oui_pour_essentiel=4, oui_absolument=5",
          "core": true
        },
        {
          "questionId": "min_pred_sentiment",
          "weight": 1,
          "scoringLogic": "direct slider: high = uncomfortable = stronger boundary",
          "conditionalOn": "clergyUsesAI",
          "core": false
        },
        {
          "questionId": "min_care_email",
          "weight": 1,
          "scoringLogic": "non=5, oui_relu=3, oui_tel_quel=1 (v1 non_jamais=5, oui_brouillon=3, oui_souvent=1)",
          "conditionalOn": "isClergy",
          "core": false
        },
        {
          "questionId": "laic_substitution_priere",
          "weight": 1,
          "scoringLogic": "non=5, oui_negatif=3, oui_neutre=2, oui_positif=1",
          "conditionalOn": "isLayperson",
          "core": false
        },
        {
          "questionId": "laic_conseil_spirituel",
          "weight": 1,
          "scoringLogic": "jamais=5, complement=3, oui_possible=2, deja_fait=1",
          "conditionalOn": "isLayperson",
          "core": false
        }
      ]
    },
    "ethicalConcern": {
      "id": "ethicalConcern",
      "name": {
        "fr": "Préoccupation éthique",
        "en": "Ethical concern"
      },
      "description": {
        "fr": "Inquiétude exprimée sur l'utilité, l'opacité des systèmes et l'anthropologie théologique",
        "en": "Concern about usefulness, system opacity and theological anthropology"
      },
      "validationStatus": "inspired_by",
      "sourceInstrument": "Items inspired by AIAS (Wang & Wang, 2022); the scale itself is not administered",
      "scale": {
        "min": 1,
        "max": 5
      },
      "minItems": 2,
      "aggregation": "Weighted mean over answered items; value = null below minItems; confidence = nItems / maxItems",
      "missingPolicy": "\"ne sait pas\", \"sans réponse\", unanswered and unrecognised values are excluded from the mean and never imputed",
      "questions": [
        {
          "questionId": "theo_utilite_percue",
          "weight": 1,
          "scoringLogic": "reversed: tres_positif=1 ... tres_negatif=5",
          "core": true
        },
        {
          "questionId": "psych_aias_opacity",
          "weight": 1,
          "scoringLogic": "non_confiance=1, non_indifferent=1.5, peu=2.5, oui_moderement=4, oui_fortement=5",
          "core": true
        },
        {
          "questionId": "psych_imago_dei",
          "weight": 1,
          "scoringLogic": "pas_du_tout=1 ... totalement=5",
          "core": true
        }
      ]
    },
    "psychologicalPerception": {
      "id": "psychologicalPerception",
      "name": {
        "fr": "Perception de l'IA",
        "en": "AI perception"
      },
      "description": {
        "fr": "Attribution de traits humains, de conscience et de capacité de remplacement à l'IA",
        "en": "Attribution of human traits, consciousness and replacement capability to AI"
      },
      "validationStatus": "inspired_by",
      "sourceInstrument": "Items inspired by the Godspeed series (Bartneck et al., 2009); the scale itself is not administered",
      "scale": {
        "min": 1,
        "max": 5
      },
      "minItems": 2,
      "aggregation": "Weighted mean over answered items; value = null below minItems; confidence = nItems / maxItems",
      "missingPolicy": "\"ne sait pas\", \"sans réponse\", unanswered and unrecognised values are excluded from the mean and never imputed",
      "questions": [
        {
          "questionId": "psych_godspeed_nature",
          "weight": 1,
          "scoringLogic": "1_machine=1 ... 5_humain=5",
          "core": true
        },
        {
          "questionId": "psych_godspeed_conscience",
          "weight": 1,
          "scoringLogic": "impossible=1, imitation=2, incertain=3, possible_emergence=4, probable=5",
          "core": true
        },
        {
          "questionId": "psych_anxiete_remplacement",
          "weight": 1,
          "scoringLogic": "non_impossible=1, non_peu_probable=2, possible_partiel=3, oui_probable=4, oui_certain=5",
          "core": true
        }
      ]
    },
    "communityContext": {
      "id": "communityContext",
      "name": {
        "fr": "Contexte communautaire",
        "en": "Community context"
      },
      "description": {
        "fr": "Valence de la position communautaire et fréquence des échanges sur l'IA",
        "en": "Valence of the community stance and frequency of discussions about AI"
      },
      "validationStatus": "exploratory",
      "sourceInstrument": null,
      "scale": {
        "min": 1,
        "max": 5
      },
      "minItems": 2,
      "aggregation": "Weighted mean over answered items; value = null below minItems; confidence = nItems / maxItems",
      "missingPolicy": "\"ne sait pas\", \"sans réponse\", unanswered and unrecognised values are excluded from the mean and never imputed",
      "questions": [
        {
          "questionId": "communaute_position_officielle",
          "weight": 1,
          "scoringLogic": "valence only: oui_defavorable=1, oui_prudent=3, oui_favorable=5; \"non\" and \"ne sait pas\" are missing",
          "core": true
        },
        {
          "questionId": "communaute_perception_pairs",
          "weight": 1,
          "scoringLogic": "valence: hostile=1, mefiant=2, neutre=3, opinions_variees=3, favorable=4, tres_favorable=5",
          "core": true
        },
        {
          "questionId": "communaute_discussions",
          "weight": 1,
          "scoringLogic": "jamais=1, rarement=2, parfois=3, souvent=4, organise=5",
          "core": true
        }
      ]
    },
    "futureOrientation": {
      "id": "futureOrientation",
      "name": {
        "fr": "Orientation future",
        "en": "Future orientation"
      },
      "description": {
        "fr": "Intentions d'usage, souhait de formation et étendue des domaines d'intérêt",
        "en": "Usage intentions, training interest and breadth of domains of interest"
      },
      "validationStatus": "exploratory",
      "sourceInstrument": null,
      "scale": {
        "min": 1,
        "max": 5
      },
      "minItems": 2,
      "aggregation": "Weighted mean over answered items; value = null below minItems; confidence = nItems / maxItems",
      "missingPolicy": "\"ne sait pas\", \"sans réponse\", unanswered and unrecognised values are excluded from the mean and never imputed",
      "questions": [
        {
          "questionId": "futur_intention_usage",
          "weight": 1,
          "scoringLogic": "non_certain=1 ... oui_certain=5",
          "core": true
        },
        {
          "questionId": "futur_formation_souhait",
          "weight": 1,
          "scoringLogic": "non_pas_du_tout=1 ... oui_tres=5",
          "core": true
        },
        {
          "questionId": "futur_domaines_interet",
          "weight": 1,
          "scoringLogic": "aucun_domaines=1, else 1 + 0.6 * number of domains, capped at 5",
          "core": true
        }
      ]
    }
